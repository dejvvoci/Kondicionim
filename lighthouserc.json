{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.ts dist/e2e/browser 4320",
      "startServerReadyPattern": "serve:",
      "url": [
        "http://localhost:4320/",
        "http://localhost:4320/sherbimet/montim-split/",
        "http://localhost:4320/si-te-zgjidhni-kondicionerin/",
        "http://localhost:4320/projektet/",
        "http://localhost:4320/keshilla/pse-me-pikon-kondicioneri/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
