{
  "name": "kondicionim",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.ts && ng serve",
    "build": "node scripts/check-content.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.ts && ng build && node scripts/postbuild.ts && node scripts/check-dist.ts",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "check:content": "node scripts/check-content.ts",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/serve.ts",
    "build:map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-map.ts",
    "build:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.ts && ng build --configuration production,e2e && node scripts/postbuild.ts dist/e2e/browser && node scripts/check-dist.ts dist/e2e/browser",
    "e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "build:og": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-og.ts"
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.29",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
